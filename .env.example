DATABASE_URL=postgres://yoltick_app:CHANGE_ME@localhost:5433/yoltick_dev
TEST_DATABASE_URL=postgres://yoltick_app:CHANGE_ME@localhost:5433/yoltick_test
NODE_ENV=development
PAYMENT_GATEWAY=fake
SMS_PROVIDER=fake
REAL_SALES_ENABLED=false
# Optional path to the existing PostgreSQL client bin directory (pg_dump/pg_restore).
PG_BIN=
SESSION_SECRET=CHANGE_ME_LONG_RANDOM
ADMIN_EMAIL=
ADMIN_PASSWORD=
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=
# Optional canonical origin behind a reverse proxy; no trailing slash.
# APP_ORIGIN=https://YOUR_HOST
# Public, no-sales preview in production: set both adapters to disabled.
# PAYMENT_GATEWAY=disabled
# SMS_PROVIDER=disabled
