# Server template only. Install as /opt/yoltick/.env, root:yoltick_web, mode 0640.
# Requires matching OS/PostgreSQL role yoltick_web and local peer authentication.
DATABASE_URL=postgresql:///yoltick_app?host=/var/run/postgresql&user=yoltick_web
NODE_ENV=production
PAYMENT_GATEWAY=disabled
SMS_PROVIDER=disabled
REAL_SALES_ENABLED=false
APP_ORIGIN=https://yoltic.ir
